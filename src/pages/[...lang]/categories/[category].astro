---
import PostArchiveLayout from "../../../layouts/PostArchiveLayout.astro";
import I18nKeys from "../../../locales/keys";
import {
  DEFAULT_LOCALE,
  LOCALES,
  localeFromPath,
  useI18n,
} from "../../../locales/translation";
import { GetCategories, type Archive } from "../../../utils/content";
import { yearInSiteTimeZone } from "../../../utils/date";

export async function getStaticPaths() {
  const paths = [];
  for (const locale of LOCALES) {
    const categories = await GetCategories(locale);
    for (const category of categories.keys()) {
      paths.push({
        params: {
          lang: locale === DEFAULT_LOCALE ? undefined : locale,
          category,
        },
      });
    }
  }
  return paths;
}

const locale = localeFromPath(Astro.url.pathname);
const i18n = useI18n(Astro.url.pathname);
const categories = await GetCategories(locale);
const { category } = Astro.params;

const posts = categories.get(category)!.posts;
const categoryName = categories.get(category)!.name;
const archiveMap = new Map<number, Array<Archive>>();
[...posts]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .forEach((post) => {
    const year = yearInSiteTimeZone(post.date);
    if (archiveMap.has(year)) archiveMap.get(year)!.push(post);
    else archiveMap.set(year, [post]);
  });
const orderedArchiveMap = new Map(
  [...archiveMap.entries()].sort((a, b) => b[0] - a[0]),
);
---

<PostArchiveLayout
  archiveMap={orderedArchiveMap}
  title={categoryName}
  subTitle={i18n(I18nKeys.pages_categories_archive)}
/>
