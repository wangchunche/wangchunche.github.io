---
import ChipLayout from "../../../layouts/ChipLayout.astro";
import I18nKeys from "../../../locales/keys";
import { localeFromPath, useI18n } from "../../../locales/translation";
import { GetTags } from "../../../utils/content";
import { getLocalePaths } from "../_locale";

export const getStaticPaths = getLocalePaths;

const locale = localeFromPath(Astro.url.pathname);
const i18n = useI18n(Astro.url.pathname);
const tags = [...(await GetTags(locale)).values()].sort();
const chips = tags.map((tag) => {
  return {
    name: tag.name,
    slug: tag.slug,
    subChip: tag.posts.length.toString(),
  };
});
---

<ChipLayout chips={chips} title={i18n(I18nKeys.pages_tags_title)} />
